# /etc/zoomriya/id.env: ZOOMRIYA ID's settings on the box (chmod 0600, root).
# Every setting is in backend/app/config.py.

DATABASE_URL=postgresql+psycopg://zoomriya_id:CHANGE-ME@127.0.0.1:5432/zoomriya_id
# Its own Redis account: sudo platform/redis/setup.sh writes the full URL here.
REDIS_URL=redis://127.0.0.1:6379/0
ZOOMRIYA_ID_DATA_DIR=/data/zoomriya-id

# The apps installed on this box: every member gets each one unless an admin
# switches it off in Manage Family. Each app's installer adds itself; none
# when ZOOMRIYA OS sets ZOOMRIYA ID up.
INSTALLED_APPS=

# On once the box is served over HTTPS.
#AUTH_COOKIE_SECURE=true
